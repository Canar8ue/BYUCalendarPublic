    "voice-intro": {
      "id": "voice-intro",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "I’m Maya. Four pieces of your lost page are somewhere out here. Start with the library. Follow the gold marker.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-intro-954cf98fd007.mp3",
      "url": "/explorer/audio/voice-intro-954cf98fd007.mp3",
      "bytes": 116653,
      "sha256": "954cf98fd007f0bb698c6979b6f6089c1b754537432f1a372b4df045f2546ee9",
      "edit": {
        "sourceSha256": "fc874e57a526d978a9ea742d877f706e04b330035748b2ce505d7b0fb970fca6",
        "start": 2.76,
        "end": 9.97
      }
    },
    "voice-fragment-orientation": {
      "id": "voice-fragment-orientation",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "Your first piece! The library, the student center, and a little curiosity. That’s a pretty good start. Next stop: the science district. Your scooter is always one tap away.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-fragment-orientation-9005f1efe725.mp3",
      "url": "/explorer/audio/voice-fragment-orientation-9005f1efe725.mp3",
      "bytes": 195647,
      "sha256": "9005f1efe725a83b6a1fc582c982aa8254128acbc32e2ba67f2a715901cf7d3f"
    },
    "voice-fragment-long-way": {
      "id": "voice-fragment-long-way",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "Two pieces. Nicely wandered! Now head east. Someone left a melody between the Arts Building and the Music Building. There’s a whole different rhythm over there.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-fragment-long-way-e45bc010d972.mp3",
      "url": "/explorer/audio/voice-fragment-long-way-e45bc010d972.mp3",
      "bytes": 171406,
      "sha256": "e45bc010d972080d2fbb064d2f928f901e156a109e3638a44f6a30be1fb991ef"
    },
    "voice-fragment-sound-vision": {
      "id": "voice-fragment-sound-vision",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "Three pieces, one very good detour. Your last lead points north, toward the bells. Keep an eye out for someone in blue and white.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-fragment-sound-vision-a1dcca1dfb26.mp3",
      "url": "/explorer/audio/voice-fragment-sound-vision-a1dcca1dfb26.mp3",
      "bytes": 148418,
      "sha256": "a1dcca1dfb26b3487e2a129c191d3df7fe34993195864d7ab304d87eea073f42"
    },
    "voice-fragment-familiar-face": {
      "id": "voice-fragment-familiar-face",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "You found the last piece. Bring them back to the little departure board where we started. I have a feeling your calendar is going to look a lot more interesting now.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-fragment-familiar-face-cf638c1c0bad.mp3",
      "url": "/explorer/audio/voice-fragment-familiar-face-cf638c1c0bad.mp3",
      "bytes": 150926,
      "sha256": "cf638c1c0bad2e138fc27796949e468ed12670236f62204e1ee29d9f27104db5"
    },
    "voice-finale": {
      "id": "voice-finale",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "There it is. Your way back.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-finale-d2265f177ac3.mp3",
      "url": "/explorer/audio/voice-finale-d2265f177ac3.mp3",
      "bytes": 38077,
      "sha256": "d2265f177ac3f5c4103cb1e70305690278a5283e2c86dae6007f7b7f8d890331",
      "edit": {
        "sourceSha256": "4f857bf8ee97b3676cfd4f01f4831360316bcefe452e2c0120a5c1015292d1e9",
        "start": 0,
        "end": 2.3
      }
    },
    "voice-cat-start": {
      "id": "voice-cat-start",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "Well, hello there. That cat looks like it knows exactly where it’s going. Which is more than we can say. Follow the little paw prints.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-cat-start-112ab0d2b934.mp3",
      "url": "/explorer/audio/voice-cat-start-112ab0d2b934.mp3",
      "bytes": 136715,
      "sha256": "112ab0d2b9347d1717210a7b45196b63cbe34f80efc7e1be908afa2d2aba4682"
    },
    "voice-cat-finish": {
      "id": "voice-cat-finish",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "Mystery solved. It wasn’t a secret passage. It was a very carefully selected napping spot. I think you’ve made a friend.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-cat-finish-616b301640e3.mp3",
      "url": "/explorer/audio/voice-cat-finish-616b301640e3.mp3",
      "bytes": 139223,
      "sha256": "616b301640e32dd340dceae53ae5c6db5ddc09dd4cf208db01447b33ace18196"
    },
    "voice-delivery": {
      "id": "voice-delivery",
      "kind": "voice",
      "speaker": "Noah · slightly lost student",
      "caption": "Hey! I took the scenic route, and now I can’t find Engineering. Could you scout the way for me? No rush. Well… a little rush. Thank you!",
      "voice": "bIHbv24MWmeRgasZH58o",
      "file": "voice-delivery-e998dc61d145.mp3",
      "url": "/explorer/audio/voice-delivery-e998dc61d145.mp3",
      "bytes": 149672,
      "sha256": "e998dc61d1457d74dc22a00e7a07a4be6602a21a8616ae5bb57151221e5ea3fa"
    },
    "voice-lost-found": {
      "id": "voice-lost-found",
      "kind": "voice",
      "speaker": "Noah",
      "caption": "My notebook, my scarf, and my water bottle! I was having a spectacularly disorganized day. Thanks for bringing everything home.",
      "voice": "bIHbv24MWmeRgasZH58o",
      "file": "voice-lost-found-04cc452c3ec5.mp3",
      "url": "/explorer/audio/voice-lost-found-04cc452c3ec5.mp3",
      "bytes": 136715,
      "sha256": "04cc452c3ec5aa8de4b1fac7b89be9c9c355b67ead7dac7e4bce76795e76c063"
    },
    "voice-music": {
      "id": "voice-music",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "Sun, wave, star. You found the campus melody. Sometimes the way forward is just three little notes.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-music-6ef4a2c314ec.mp3",
      "url": "/explorer/audio/voice-music-6ef4a2c314ec.mp3",
      "bytes": 131700,
      "sha256": "6ef4a2c314ec06c1a73d0850ee7091fddc807135fad67b8a9aa34248b95e9a14"
    },
    "voice-cosmo": {
      "id": "voice-cosmo",
      "kind": "voice",
      "speaker": "Maya",
      "caption": "There he is! The most enthusiastic person on campus. And somehow, always in three places at once.",
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "file": "voice-cosmo-dd24f6aee516.mp3",
      "url": "/explorer/audio/voice-cosmo-dd24f6aee516.mp3",
      "bytes": 121251,
